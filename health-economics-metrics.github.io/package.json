{
  "name": "health-economics-metrics.github.io",
  "version": "0.1.0",
  "description": "Health Economics Metrics website",
  "type": "module",
  "private": "true",
  "license": "ISC",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "sync": "node bin/sync-content.mjs && node bin/vendor-lily.mjs",
    "sync:content": "node bin/sync-content.mjs",
    "sync:lily": "node bin/vendor-lily.mjs",
    "dev": "vite dev",
    "build": "vite build && node scripts/build-search-index.mjs build && node scripts/build-llms.mjs build && node scripts/build-sitemap.mjs build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-headless": "^0.2.0",
    "@lilydesignsystem/svelte-picker-bar": "^0.2.0",
    "@lilydesignsystem/themes": "^0.1.0",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.14"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
